rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFolder(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.color is string && data.color.size() > 0 && data.color.size() <= 30 &&
             data.icon is string && data.icon.size() > 0 && data.icon.size() <= 50 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDocument(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.folderId is string && data.folderId.size() > 0 && data.folderId.size() <= 128 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.fileType is string && data.fileType in ['pdf', 'docx', 'doc', 'xlsx', 'xls', 'pptx', 'ppt', 'csv', 'scanned', 'pic', 'txt'] &&
             data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 200 &&
             data.fileSize is int && data.fileSize >= 0 && data.fileSize <= 50000000 &&
             data.content is string && data.content.size() <= 5000000 &&
             data.isEncrypted is bool &&
             (!('encryptionKeyHint' in data) || data.encryptionKeyHint == null || (data.encryptionKeyHint is string && data.encryptionKeyHint.size() <= 100)) &&
             data.isOfflineCached is bool &&
             (!('pageCount' in data) || (data.pageCount is int && data.pageCount >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      match /folders/{folderId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(folderId);
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(folderId) &&
                         isValidFolder(incoming()) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'name', 'color', 'icon', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'color', 'icon', 'createdAt', 'updatedAt']);

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(folderId) &&
                         isValidFolder(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'icon', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(folderId);
      }

      match /documents/{documentId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(documentId);
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(documentId) &&
                         isValidDocument(incoming()) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'folderId', 'category', 'fileType', 'fileName', 'fileSize', 'content', 'isEncrypted', 'isOfflineCached', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'folderId', 'category', 'fileType', 'fileName', 'fileSize', 'content', 'isEncrypted', 'encryptionKeyHint', 'isOfflineCached', 'pageCount', 'createdAt', 'updatedAt']);

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(documentId) &&
                         isValidDocument(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'folderId', 'category', 'content', 'isEncrypted', 'encryptionKeyHint', 'isOfflineCached', 'pageCount', 'fileSize', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(documentId);
      }
    }
  }
}
