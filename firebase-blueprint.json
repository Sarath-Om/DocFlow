{
  "entities": {
    "Folder": {
      "title": "Folder",
      "description": "Personalized user folder for organizing PDF, Word, Excel, PowerPoint, Scanned, and Picture documents",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "name": { "type": "string", "description": "Folder display name" },
        "color": { "type": "string", "description": "Hex color string" },
        "icon": { "type": "string", "description": "Folder icon identifier" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "color", "icon", "createdAt", "updatedAt"]
    },
    "Document": {
      "title": "Document",
      "description": "PDF, Word, Excel, PowerPoint, Scanned, or Picture document with optional AES-256 encryption",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Document title" },
        "folderId": { "type": "string", "description": "Parent folder ID or 'root'" },
        "category": { "type": "string", "description": "Document category" },
        "fileType": {
          "type": "string",
          "enum": ["pdf", "docx", "doc", "xlsx", "xls", "pptx", "ppt", "csv", "scanned", "pic", "txt"]
        },
        "fileName": { "type": "string", "description": "Original or generated file name" },
        "fileSize": { "type": "integer", "description": "File size in bytes" },
        "content": { "type": "string", "description": "Plain or AES-256 encrypted structured content" },
        "isEncrypted": { "type": "boolean", "description": "Whether content is AES-256 encrypted" },
        "encryptionKeyHint": { "type": "string", "description": "Optional hint for passphrase" },
        "isOfflineCached": { "type": "boolean", "description": "Whether pinned for offline Room access" },
        "pageCount": { "type": "integer", "description": "Number of pages, slides, or sheets" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "title",
        "folderId",
        "category",
        "fileType",
        "fileName",
        "fileSize",
        "content",
        "isEncrypted",
        "isOfflineCached",
        "createdAt",
        "updatedAt"
      ]
    },
    "PdfAnnotation": {
      "title": "PdfAnnotation",
      "description": "PDF markup annotation (Draw, Highlight, Text Box, Sticky Note) synced via WorkManager to Firebase",
      "type": "object",
      "properties": {
        "ymapKey": { "type": "string", "description": "Unique Y.Map annotation key" },
        "documentId": { "type": "string", "description": "Parent document ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "pageIndex": { "type": "integer", "description": "Zero-based PDF page index" },
        "toolType": { "type": "string", "description": "PEN, HIGHLIGHT, TEXT_BOX, MARKER, STICKY_NOTE" },
        "colorHex": { "type": "string", "description": "Stroke or box hex color" },
        "strokeWidth": { "type": "number", "description": "Stroke width" },
        "normalizedPointsEncoded": { "type": "string", "description": "Encoded normalized coordinates" },
        "stickyNoteText": { "type": "string", "description": "Text box or sticky note content" },
        "authorName": { "type": "string", "description": "Author display name" },
        "crdtClock": { "type": "integer", "description": "CRDT logical clock" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ymapKey", "documentId", "userId", "pageIndex", "toolType", "colorHex"]
    }
  },
  "firestore": {
    "/users/{userId}/folders/{folderId}": {
      "schema": { "$ref": "#/entities/Folder" },
      "description": "User's personalized folders"
    },
    "/users/{userId}/documents/{documentId}": {
      "schema": { "$ref": "#/entities/Document" },
      "description": "User's synchronized documents across PDF, Word, Excel, PowerPoint, Scanned, and Pic formats"
    },
    "/users/{userId}/documents/{documentId}/annotations/{annotationId}": {
      "schema": { "$ref": "#/entities/PdfAnnotation" },
      "description": "PDF markup annotations synced via WorkManager"
    }
  }
}
