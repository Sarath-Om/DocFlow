<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header Bar: Brand Logo + App Title and One-Tap Quick Scan Button -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_docflow_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DocFlow"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Access &amp; Scanner"
                android:textColor="#FF94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- One-Tap Quick Scan Camera Button -->
        <LinearLayout
            android:id="@+id/widget_btn_quick_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_scan_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_camera"
                android:contentDescription="Camera Scanner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Quick Scan"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subheader: Recent Documents Label -->
    <TextView
        android:id="@+id/widget_section_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RECENTLY OPENED"
        android:textColor="#FF64748B"
        android:textSize="9sp"
        android:textStyle="bold"
        android:paddingTop="2dp"
        android:paddingBottom="4dp" />

    <!-- Container for Top 3 Recent Documents -->
    <LinearLayout
        android:id="@+id/widget_docs_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Document Item 1 -->
        <LinearLayout
            android:id="@+id/widget_doc_item_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_item_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/widget_doc_1_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_document"
                android:contentDescription="Document" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/widget_doc_1_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Document 1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_doc_1_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Work • Just now"
                    android:textColor="#FF94A3B8"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_doc_1_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:text="PDF"
                android:textColor="#FF38BDF8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <!-- Document Item 2 -->
        <LinearLayout
            android:id="@+id/widget_doc_item_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_item_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/widget_doc_2_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_document"
                android:contentDescription="Document" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/widget_doc_2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Document 2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_doc_2_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personal • 1h ago"
                    android:textColor="#FF94A3B8"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_doc_2_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:text="DOCX"
                android:textColor="#FF60A5FA"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <!-- Document Item 3 -->
        <LinearLayout
            android:id="@+id/widget_doc_item_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_item_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/widget_doc_3_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_document"
                android:contentDescription="Document" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/widget_doc_3_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Document 3"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_doc_3_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Finance • Yesterday"
                    android:textColor="#FF94A3B8"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_doc_3_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:text="XLSX"
                android:textColor="#FF34D399"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State: Shown when no cached documents exist -->
    <LinearLayout
        android:id="@+id/widget_empty_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No documents opened yet"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap Quick Scan or open DocFlow to import files"
            android:textColor="#FF94A3B8"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
